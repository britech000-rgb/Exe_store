<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="280dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/bkm_swing" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/title"
            android:textColor="@color/gold"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/tagline"
            android:textAllCaps="true"
            android:textColor="@color/ink"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/body"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/privacy"
            android:textColor="#C8BBA4"
            android:textSize="15sp" />

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/gold"
            android:text="@string/put_on_screen"
            android:textAllCaps="false"
            android:textColor="@color/bg"
            android:textSize="16sp" />

        <Button
            android:id="@+id/alerts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/card"
            android:text="@string/alerts"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/mic"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/card"
            android:text="@string/mic"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/texts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/card"
            android:text="@string/texts"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/contacts"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/card"
            android:text="@string/contacts"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/ai_key"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:autofillHints=""
            android:background="@color/card"
            android:hint="@string/ai_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textColorHint="#C8BBA4"
            android:textSize="15sp" />

        <Button
            android:id="@+id/save_key"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/card"
            android:text="@string/save_key"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/key_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/key_missing"
            android:textColor="#C8BBA4"
            android:textSize="14sp" />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/card"
            android:text="@string/turn_off"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
